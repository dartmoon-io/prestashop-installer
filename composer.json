{
    "name": "dartmoon/prestashop-installer",
    "description": "Global CLI installer for Dartmoon PrestaShop modules",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dartmoon",
            "homepage": "https://dartmoon.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/filesystem": "^6.4 || ^7.4",
        "symfony/process": "^6.4 || ^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^10.5",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Dartmoon\\PrestaShopInstaller\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dartmoon\\PrestaShopInstaller\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/prestashop"
    ],
    "scripts": {
        "test": "phpunit",
        "quality": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality:fix": "@php vendor/bin/php-cs-fixer fix",
        "verify": [
            "@quality",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": false
    }
}
